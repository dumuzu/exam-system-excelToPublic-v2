{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/client/app/**/*",
    "src/client/features/**/*",
    "src/client/student-entry/**/*",
    "src/client/shared/api/**/*",
    "src/client/shared/i18n/**/*",
    "src/client/shared/patterns/**/*",
    "src/client/shared/ui/**/*",
    "src/types/**/*"
  ]
}
