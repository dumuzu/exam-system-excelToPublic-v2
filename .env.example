# This file is safe to commit. Copy it to .env and replace every placeholder.
# Do not commit the resulting .env file.

# Never enable the isolated test administrator in a public deployment.
ENABLE_TEST_ADMIN=false

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-session-secret-of-at-least-32-characters

# Authenticates the server-side expired-attempt scanner (for a scheduler or a
# teacher-triggered maintenance request). Use a different 32+ character value.
CRON_SECRET=replace-with-a-separate-random-cron-secret-of-at-least-32-characters

# PostgreSQL URL for the running web application. A connection-pooler URL is
# recommended for serverless hosting; a normal PostgreSQL URL works for Node/Docker.
DATABASE_URL=postgresql://user:password@postgres-host:5432/exam_system?sslmode=require

# Direct PostgreSQL URL for one-time schema migrations only. On a conventional
# PostgreSQL server this can be the same database with a migration-capable role.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@postgres-host:5432/exam_system?sslmode=require

# Node server binding. HOST=0.0.0.0 is required inside a container.
HOST=127.0.0.1
PORT=4173

# One-time values for `npm run auth:bootstrap`. Do not keep the password in a
# committed file or hosting environment after the first administrator exists.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Small, bounded defaults for a free-tier database and a single teacher instance.
# Leave unset to use the tested defaults below. Values outside the allowed range
# are ignored instead of being trusted blindly.
# DATABASE_POOL_MAX=4
# HISTORY_LIST_LIMIT=100
# IN_MEMORY_HISTORY_RECORD_LIMIT=200
# MAX_REQUEST_BODY_KB=64
# MAX_AUTHORING_REQUEST_BODY_KB=4096
# MAX_ROSTER_REQUEST_BODY_KB=256
# MAX_SUBMISSION_REQUEST_BODY_KB=1280
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_SECONDS=900
# LOGIN_RATE_TRACKED_KEY_LIMIT=1000
