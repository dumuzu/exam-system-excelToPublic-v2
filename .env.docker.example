# Copy this file to .env.docker, then replace every value beginning with "replace-".
# Keep .env.docker private. Use URL-safe letters, numbers, underscores and hyphens
# for POSTGRES_PASSWORD because it is embedded in the local connection URL.

APP_PORT=4173
POSTGRES_DB=exam_system
POSTGRES_USER=exam_system
POSTGRES_PASSWORD=replace-with-a-url-safe-random-database-password

SESSION_SECRET=replace-with-a-random-session-secret-of-at-least-32-characters
CRON_SECRET=replace-with-a-separate-random-cron-secret-of-at-least-32-characters

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Optional. The tested default is intentionally small for a single application instance.
DATABASE_POOL_MAX=4
